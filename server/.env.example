# Vorlage für server/.env – diese Datei kopieren und ausfüllen:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
#
# server/.env enthält Zugangsdaten und wird nicht in die Versionsverwaltung
# aufgenommen. Nach jeder Änderung den Server neu starten.

# Port des Alarmservers
# PORT=3001

# Netzwerkschnittstelle. 127.0.0.1 bedeutet: nur lokal erreichbar – richtig,
# wenn ein Webserver davorsteht. 0.0.0.0 macht den Server im Netz erreichbar.
# HOST=0.0.0.0

# Verzeichnis mit dem gebauten Portal. Liegt es vor, liefert der Server das
# Portal unter derselben Adresse aus wie die Schnittstelle.
# SOBE_WEB_ROOT=../dist

# Pfad der Datenbankdatei
# SOBE_DB_PATH=data/sobe-notfall.sqlite

# Konto und Erstpasswort des ersten Administrators
# SOBE_ADMIN_EMAIL=stefan.gross@sonnenberg-baar.ch
# SOBE_ADMIN_PASSWORD=SOBE-Start2026!

# Zugangstoken von expo.dev, nötig für den iOS-Build über den Update-Knopf.
# Zu finden unter expo.dev -> Account settings -> Access tokens.
# Wie ein Passwort behandeln: nie weitergeben, nie einchecken.
# Solange die Zeile leer ist, bleibt «Server und iOS-App» im Portal gesperrt.
EXPO_TOKEN=

# Automatischen Neustart nach der Aktualisierung abschalten
# SOBE_AUTO_RESTART=false
